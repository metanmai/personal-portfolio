# Steam — recently played games feed (System Monitor)
# Get API key at: https://steamcommunity.com/dev/apikey
# Find your 64-bit Steam ID at: https://steamid.io
STEAM_API_KEY=your-steam-api-key
STEAM_ID64=your-steam-64bit-id

# Last.fm — recent tracks feed (System Monitor)
# Get API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_USERNAME=your-lastfm-username

# LeetCode (optional — defaults to "metanmai")
# LEETCODE_USERNAME=metanmai
